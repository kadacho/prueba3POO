<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>

<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.layout.HBox?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.martin.viviendas.controller.ViviendasController">
    <padding>
        <Insets bottom="20.0" left="30.0" right="30.0" top="20.0"/>
    </padding>
    <HBox>
        <Label text="Registro de viviendas" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    </HBox>

    <TableView fx:id="tablaViviendas" >
        <columns>
            <TableColumn fx:id="colTipo" text="Tipo"/>
            <TableColumn fx:id="colCodigo" text="Código"/>
            <TableColumn fx:id="colSuperficie" text="Superficie (m²)"/>
            <TableColumn fx:id="colHabitaciones" text="Habitaciones"/>
            <TableColumn fx:id="colCosto" text="Costo arriendo"/>
        </columns>
    </TableView>
    <HBox spacing="10.0">
        <Button text="Agregar" onAction="#irFormulario"/>
        <Button text="Eliminar" onAction="#irFormulario"/>
    </HBox>
</VBox>
