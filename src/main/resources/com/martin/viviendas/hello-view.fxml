<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="400.0" prefWidth="650.0" spacing="15.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.martin.viviendas.controller.ViviendasController">
    <padding>
        <Insets bottom="20.0" left="30.0" right="30.0" top="20.0"/>
    </padding>

    <Label text="Registro de viviendas" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <TableView fx:id="tablaViviendas" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colTipo" text="Tipo" prefWidth="120.0"/>
            <TableColumn fx:id="colCodigo" text="Código" prefWidth="90.0"/>
            <TableColumn fx:id="colSuperficie" text="Superficie (m²)" prefWidth="130.0"/>
            <TableColumn fx:id="colHabitaciones" text="Habitaciones" prefWidth="110.0"/>
            <TableColumn fx:id="colCosto" text="Costo arriendo" prefWidth="130.0"/>
        </columns>
    </TableView>

    <HBox spacing="10.0">
        <Button text="Agregar" onAction="#irFormulario"/>
        <Button text="Eliminar" onAction="#eliminarVivienda"/>
    </HBox>
</VBox>